# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.

# Neon pooled connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

ANTHROPIC_API_KEY=sk-ant-

# The staff password for /admin. Any string; this prototype uses one shared password.
ADMIN_PASSWORD=

# Optional. Defaults to claude-opus-5. See "Why the model tier is what it is" in the README.
ANTHROPIC_MODEL=
